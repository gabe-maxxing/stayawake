buddy_color() {
  case "$1" in
    '#') color=240 ;;
    '+') color=230 ;;
    '.') color=255 ;;
    '-') color=180 ;;
    '=') color=214 ;;
    *) color='' ;;
  esac
}

draw_buddy() {
  local mood=$1 render_color=${2:-0} top bottom upper lower color index
  case "$mood" in
    asleep) printf '                     z Z\n' ;;
    asleep-dozing) printf '                       z Z\n'; mood=asleep ;;
    alert) printf '                                    !!\n' ;;
  esac
  if [[ $render_color == 0 ]]; then
    buddy_sprite "$mood"
    return
  fi

  # Half blocks let two square pixels share each terminal cell.
  while IFS= read -r top; do
    IFS= read -r bottom || bottom=''
    for ((index = 0; index < ${#top} || index < ${#bottom}; index++)); do
      buddy_color "${top:index:1}"; upper=$color
      buddy_color "${bottom:index:1}"; lower=$color
      if [[ -n $upper && -n $lower ]]; then
        printf '\033[38;5;%s;48;5;%sm▀\033[0m' "$upper" "$lower"
      elif [[ -n $upper ]]; then
        printf '\033[38;5;%sm▀\033[0m' "$upper"
      elif [[ -n $lower ]]; then
        printf '\033[38;5;%sm▄\033[0m' "$lower"
      else
        printf ' '
      fi
    done
    printf '\n'
  done < <(buddy_sprite "$mood")
}

show_buddy() {
  local mood=$1 render_color=0 rows cols rest still moving frame line height
  if [[ -t 1 && ${TERM:-dumb} != dumb && -z ${NO_COLOR+x} ]]; then
    render_color=1
  fi

  still=$(draw_buddy "$mood" "$render_color")
  height=$(printf '%s\n' "$still" | /usr/bin/wc -l)

  # Leave a static pose when the frame would wrap or fill the terminal.
  if [[ ! -t 1 || ${TERM:-dumb} == dumb ]] ||
     ! read -r rows cols rest < <(/bin/stty size 2>/dev/null < /dev/tty) ||
     (( rows <= height || cols < 50 )); then
    printf '%s\n' "$still"
    return
  fi

  case "$mood" in
    awake) moving=$(draw_buddy awake-wag "$render_color") ;;
    asleep) moving=$(draw_buddy asleep-dozing "$render_color") ;;
  esac
  printf '%s\n' "$still"
  for frame in "$moving" "$still" "$moving" "$still"; do
    /bin/sleep 0.18
    printf '\033[%dA' "$height"
    while IFS= read -r line; do
      printf '%s\033[K\n' "$line"
    done <<< "$frame"
  done
}

valid_version() {
  [[ $1 =~ ^[0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}$ ]]
}

newer_than() {
  local left_major left_minor left_patch right_major right_minor right_patch
  valid_version "$1" && valid_version "$2" || return 1
  IFS=. read -r left_major left_minor left_patch <<< "$1"
  IFS=. read -r right_major right_minor right_patch <<< "$2"
  (( (10#$left_major * 1000000 + 10#$left_minor) * 1000000 + 10#$left_patch >
     (10#$right_major * 1000000 + 10#$right_minor) * 1000000 + 10#$right_patch ))
}

latest_release() {
  local target tag
  target=$(/usr/bin/curl -q --head --location --fail --silent     --proto '=https' --proto-redir '=https' --max-redirs 3     --connect-timeout 1 --max-time 2 --output /dev/null     --write-out '%{url_effective}' "$RELEASE_URL/latest") || return 1
  [[ $target == "$RELEASE_URL/tag/v"* ]] || return 1
  tag=${target#"$RELEASE_URL/tag/v"}
  valid_version "$tag" || return 1
  printf '%s\n' "$tag"
}

release_cache_path() {
  printf '%s/stayawake/latest-release\n' "${XDG_CACHE_HOME:-$HOME/Library/Caches}"
}

write_release_cache() {
  local file=$1 now=$2 release=$3 announced=$4 temporary
  (umask 077; mkdir -p "${file%/*}") || return 1
  temporary=$(mktemp "$file.XXXXXXXX") || return 1
  if ! printf '%s %s %s\n' "$now" "$release" "$announced" > "$temporary" || ! mv -f "$temporary" "$file"; then
    rm -f "$temporary"
    return 1
  fi
}

check_updates() {
  local mode=$1 now file checked='' cached='' announced='' ttl=86400 latest
  if [[ $mode == passive ]]; then
    [[ -t 1 && ${TERM:-dumb} != dumb && ${STAYAWAKE_NO_UPDATE_CHECK:-0} != 1 ]] || return 0
  fi
  now=$(date +%s)
  file=$(release_cache_path)
  if [[ -f $file ]]; then
    read -r checked cached announced < "$file" || true
    [[ $cached == '-' ]] && ttl=900
    if [[ $mode == passive && $checked =~ ^[0-9]{1,12}$ ]] &&
      (( now >= 10#$checked && now - 10#$checked < ttl )); then
      return 0
    fi
  fi

  if ! latest=$(latest_release); then
    write_release_cache "$file" "$now" '-' "$announced" 2>/dev/null || true
    if [[ $mode == explicit ]]; then
      printf 'Whitney couldn’t reach the release page. Try again later.\n' >&2
      return 1
    fi
    return 0
  fi
  if newer_than "$latest" "$VERSION" && [[ $mode == explicit || $latest != "$announced" ]]; then
    announced=$latest
    if [[ -t 1 && ${TERM:-dumb} != dumb && -z ${NO_COLOR+x} ]]; then
      draw_buddy alert 1
    else
      draw_buddy alert
    fi
    printf 'Whitney spotted stayawake v%s! You have v%s.\n' "$latest" "$VERSION"
    printf 'Homebrew: brew upgrade gabe-maxxing/tap/stayawake\n'
    printf 'Release: %s/tag/v%s\n' "$RELEASE_URL" "$latest"
  elif [[ $mode == explicit ]]; then
    printf 'Whitney checked. You’re up to date (v%s installed; v%s latest).\n' "$VERSION" "$latest"
  fi
  write_release_cache "$file" "$now" "$latest" "$announced" 2>/dev/null || true
}

show_sleep_state() {
  local action=$1 settings sleep_disabled mood
  if [[ ! -x /usr/bin/pmset ]]; then
    echo "stayawake requires macOS." >&2
    return 1
  fi

  case "$action" in
    on)  /usr/bin/sudo /usr/bin/pmset -a disablesleep 1 ;;
    off) /usr/bin/sudo /usr/bin/pmset -a disablesleep 0 ;;
  esac

  settings=$(/usr/bin/pmset -g)
  sleep_disabled=$(/usr/bin/awk '$1 == "SleepDisabled" { print $2 }' <<< "$settings")
  case "$sleep_disabled" in
    1) echo "ON — your Mac stays awake."; mood=awake ;;
    0|"") echo "OFF — your Mac can sleep."; mood=asleep ;;
    *)
      echo "Unexpected pmset value for SleepDisabled: $sleep_disabled" >&2
      return 1
      ;;
  esac

  if [[ $action == buddy || -t 1 && ${TERM:-dumb} != dumb ]]; then
    show_buddy "$mood"
    if [[ $mood == awake ]]; then
      printf 'Whitney · on watch\n'
    else
      printf 'Whitney · off duty\n'
    fi
  fi
  check_updates passive
}

main() {
  local action=${1-status}
  if [[ $action == updates && $# == 2 && $2 == --open ]]; then
    /usr/bin/open "$RELEASE_URL/latest"
    return
  fi
  if [[ $action == buddy && $# == 2 && $2 == whitney ]]; then
    show_sleep_state buddy
    return
  fi
  if [[ $# -gt 1 ]]; then
    usage >&2
    return 2
  fi

  case "$action" in
    -h|--help) usage ;;
    -V|--version) printf 'stayawake %s\n' "$VERSION" ;;
    on|off|status|buddy) show_sleep_state "$action" ;;
    updates) check_updates explicit ;;
    *) usage >&2; return 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
