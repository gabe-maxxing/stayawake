#!/bin/bash
set -euo pipefail

VERSION=1.2.0
RELEASE_URL=https://github.com/gabe-maxxing/stayawake/releases

usage() {
  cat <<'HELP'
Usage: stayawake [on|off|status|buddy|updates [--open]|--help|--version]

  on              Keep your Mac awake
  off             Allow your Mac to sleep
  status          Show the current setting (default)
  buddy           See Whitney the Dogo Argentino on watch or asleep
  updates         Check GitHub for a newer release
  updates --open  Open the GitHub release page
  --help          Show this help
  --version       Show the installed version

Changing the setting requires an administrator password if sudo prompts.
Set STAYAWAKE_NO_UPDATE_CHECK=1 to disable automatic release checks.
HELP
}

